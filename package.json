{
  "name": "gkd-controle-diario",
  "private": true,
  "version": "2.0.0",
  "versionCode": 2,
  "type": "module",
  "scripts": {
    "dev": "DISABLE_HMR=true tsx server.ts --port 3000",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:mobile": "node scripts/inject-mobile-version.mjs",
    "build:apk": "node scripts/inject-mobile-version.mjs && npx cap sync android && node scripts/apply-android-icons.mjs",
    "apply-icons": "node scripts/apply-android-icons.mjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.0",
    "@capacitor/camera": "^6.1.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.2",
    "@google/genai": "^0.2.0",
    "@tailwindcss/vite": "^4.0.7",
    "@types/jszip": "^3.4.1",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^11.3.1",
    "firebase-admin": "^13.1.0",
    "heic-convert": "^2.1.0",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.1",
    "tailwindcss": "^4.0.7",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vite": "^6.1.1"
  }
}
