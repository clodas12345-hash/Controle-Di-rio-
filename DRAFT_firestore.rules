rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Blueprints
    function isValidDailyLog(data) {
      return data.userId == request.auth.uid
        && data.date is string && data.date.size() == 10
        && (data.kmRodado is number && data.kmRodado >= 0)
        && (data.valorKwh is number && data.valorKwh >= 0)
        && (data.capacidadeBateria is number && data.capacidadeBateria >= 0)
        && (data.isDayOff is bool);
    }

    function isValidCarProfile(data) {
      return data.userId == request.auth.uid
        && (data.modelName is string && data.modelName.size() <= 100)
        && (data.monthlyCarExpense is number && data.monthlyCarExpense >= 0);
    }

    function isValidFixedExpense(data) {
      return data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.value is number && data.value >= 0
        && data.monthKey is string && data.monthKey.size() <= 7;
    }

    // Collection Rules
    match /users/{userId} {
      allow read: if isOwner(userId);

      match /logs/{logId} {
        allow read, list: if isOwner(userId);
        allow create: if isOwner(userId) 
          && isValidId(logId) 
          && isValidDailyLog(incoming())
          && incoming().keys().hasAll(['id', 'date', 'userId'])
          && incoming().keys().size() <= 30; // Heuristic for complex log
        allow update: if isOwner(userId)
          && isValidDailyLog(incoming())
          && incoming().userId == existing().userId
          && incoming().date == existing().date;
        allow delete: if isOwner(userId);
      }

      match /profile/car {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidCarProfile(incoming());
      }

      match /fixedExpenses/{expenseId} {
        allow read, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(expenseId) && isValidFixedExpense(incoming());
        allow update: if isOwner(userId) && isValidFixedExpense(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
